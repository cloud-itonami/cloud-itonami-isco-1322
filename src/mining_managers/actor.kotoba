(ns mining-managers.actor
  "MiningManagerActor -- the ISCO-08 1322 mining manager administrative
  support actor as a `langgraph.graph/state-graph` (per ADR-2607011000 /
  CLAUDE.md Actors section). One graph run = one administrative request
  (intake -> advise -> govern -> decide -> commit/hold, with a human-approval
  interrupt for escalated proposals). No infinite internal loop; checkpointed
  per superstep so an interrupted run can resume after human sign-off.

  CRITICAL DESIGN NOTE: This actor supports a MINING MANAGER's ADMINISTRATIVE
  workflow only. It does NOT make extraction, blasting, production-targeting
  or mine-safety decisions -- those remain exclusively operator/management
  authority. The Governor enforces this hard boundary (see
  `mining-managers.governor`).

  ## What this file was on acfd967

  The README said 'a real langgraph StateGraph'. The namespace required
  neither `langgraph.graph` nor `langgraph.checkpoint`; `build-graph`
  returned a plain map nobody ran, and `run-request!` -- commented
  'Simplified stub' -- re-implemented advise/govern/decide as a threading
  macro and stopped at `:ready-to-commit`. Measured through it:

      clean request                       outcome=:ready-to-commit   records=0
      :flag-safety-concern                outcome=:escalated         ledger=0
      approve! on that state              outcome=:committed         ledger=0
      approve! on {:outcome :held ..}     outcome=:committed

  The last line is the README's 'no override path' claim, false at the actor
  level: `approve!` set `:committed` on whatever map it was handed. Nothing
  was ever written, so the ledger could not contradict it.

  State graph:
  ```text
  :intake -> :advise -> :govern -> :decide -+-> :commit                          (:ok? true)
                                             +-> :escalate -> :request-approval   (:escalate? true, interrupt-before)
                                             +-> :hold                            (:hard? true)
  ```

  `:escalate` runs BEFORE the interrupt and writes the `:disposition
  :escalate` ledger entry, so a request that waits for a human -- or is never
  approved -- has a trace. `:request-approval` is the node the graph
  interrupts before, so its body only ever runs on resume; it marks the resume
  as human-approved so `:commit` can record who authorised the write.

  The unconditional invariant: the Advisor can never directly commit a record
  the Governor refuses -- every `commit-record!` call is gated behind
  `:decide`, and `approve!` refuses a thread that is not interrupted."
  (:require [langgraph.graph :as g]
            [langgraph.checkpoint :as cp]
            [mining-managers.advisor :as advisor]
            [mining-managers.governor :as governor]
            [mining-managers.ledger :as led]
            [mining-managers.phase :as phase]
            [mining-managers.store :as store]))

(defn build-graph
  "Build a compiled MiningManagerActor graph. `store` implements
  `mining-managers.store/Store`. `advisor` implements
  `mining-managers.advisor/Advisor` (defaults to `mock-advisor`).
  `checkpointer` defaults to an in-memory one."
  [{:keys [store advisor checkpointer]
    :or {advisor (advisor/mock-advisor)
         checkpointer (cp/mem-checkpointer)}}]
  (-> (g/state-graph
       {:channels
        {:request     {:default nil}
         :context     {:default nil}
         :proposal    {:default nil}
         :verdict     {:default nil}
         :disposition {:default nil}
         :record      {:default nil}
         :approved-by {:default nil}
         :audit       {:reducer into :default []}}})
      (g/add-node :intake (fn [s] s))
      (g/add-node :advise
                   (fn [{:keys [request]}]
                     (let [p (advisor/-advise advisor store request)]
                       {:proposal p
                        :audit [{:node :advise :request request :proposal p}]})))
      (g/add-node :govern
                   (fn [{:keys [request context proposal]}]
                     (let [v (governor/check request context proposal store)]
                       {:verdict v
                        :audit [{:node :govern :verdict v}]})))
      (g/add-node :decide
                   (fn [{:keys [verdict]}]
                     {:disposition (phase/of-verdict verdict)}))
      ;; Runs BEFORE the interrupt, so the escalation is in the ledger while
      ;; the question is still open.
      (g/add-node :escalate
                   (fn [{:keys [request proposal verdict]}]
                     (store/append-ledger! store (led/escalate-entry request proposal verdict))
                     {:audit [{:node :escalate :verdict verdict}]}))
      ;; Passing through :request-approval is what a human resuming the
      ;; interrupted thread looks like from inside the graph. It records that
      ;; fact so :commit can tell an approved write from an automatic one --
      ;; the graph is the only place that still knows the difference.
      (g/add-node :request-approval
                   (fn [s] (assoc s :approved-by :human)))
      (g/add-node :commit
                   (fn [{:keys [request proposal approved-by]}]
                     (let [record {:manager-id (:manager-id request)
                                    :site-id (get-in request [:site :site-id])
                                    :op (:op proposal)
                                    :payload proposal}
                           by (or approved-by :actor)]
                       (store/commit-record! store record)
                       (store/append-ledger! store (led/commit-entry record by))
                       {:record record
                        :audit [{:node :commit :record record :approved-by by}]})))
      (g/add-node :hold
                   (fn [{:keys [verdict]}]
                     (store/append-ledger! store (led/hold-entry verdict))
                     {:audit [{:node :hold :verdict verdict}]}))
      (g/set-entry-point :intake)
      (g/add-edge :intake :advise)
      (g/add-edge :advise :govern)
      (g/add-edge :govern :decide)
      (g/add-conditional-edges
       :decide
       (fn [{:keys [disposition]}]
         (case disposition
           :commit :commit
           :request-approval :escalate
           :hold)))
      (g/add-edge :escalate :request-approval)
      (g/add-edge :request-approval :commit)
      (g/set-finish-point :commit)
      (g/set-finish-point :hold)
      (g/compile-graph {:checkpointer checkpointer
                         :interrupt-before #{:request-approval}})))

(defn run-request!
  "Run one administrative request to completion or interrupt. `thread-id`
  scopes checkpointing for resume after human approval. Returns the full
  run result: `{:state .. :events .. :status :done|:interrupted :frontier ..}`."
  [graph request context thread-id]
  (g/run* graph {:request request :context context} {:thread-id thread-id}))

(defn approve!
  "Human-in-the-loop resume: the interrupted `:request-approval` node
  advances straight to `:commit` on resume (approval is the act of resuming
  the thread).

  Refuses -- returns `{:status :refused :reason ..}` and runs nothing --
  unless the thread's latest checkpoint is `:interrupted`. Without this,
  `langgraph.graph/run*` treats a resume of a finished thread as a fresh run
  of the same request, and a resume of an unknown thread as a run with no
  request at all. Neither is an approval. On acfd967 the shipped `approve!`
  went further and marked a held state `:committed`."
  [graph thread-id]
  (let [latest (g/get-state graph thread-id)]
    (cond
      (nil? latest)
      {:status :refused :reason :no-such-thread :thread-id thread-id}

      (not= :interrupted (:status latest))
      {:status :refused :reason :thread-not-interrupted
       :thread-id thread-id :checkpoint-status (:status latest)}

      :else
      (g/run* graph nil {:thread-id thread-id :resume? true}))))
